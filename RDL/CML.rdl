    <DataSet Name="NomineeData">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT CASE WHEN cn_purposeCd IN ('3', '6') THEN 'First' WHEN cn_purposeCd IN ('7', '8') THEN 'Second' WHEN cn_purposeCd IN ('9', '10') THEN 'Third' ELSE '' END AS NomSeq, 
                  CASE WHEN cn_purposeCd = '3' THEN CASE WHEN cb_nominee_indicator = 'N' THEN 'Nominee' WHEN cb_nominee_indicator = 'G' THEN 'Guardian' END WHEN cn_purposeCd IN ('6', '8', '10') THEN 'Guardian' WHEN cn_purposeCd IN ('7', '9') 
                  THEN 'Nominee' ELSE '' END AS NomType, Client_NomineeDetails.cn_NomName AS NomName, Client_NomineeDetails.cn_NomAdd1 AS NomAdd1, Client_NomineeDetails.cn_NomAdd2 AS NomAdd2, 
                  Client_NomineeDetails.cn_NomAdd3 AS NomAdd3, Client_NomineeDetails.cn_NomAdd4 AS NomAdd4, Client_NomineeDetails.cn_NomPin AS NomPinCode, Client_NomineeDetails.cn_NomMob AS NomMobile, 
                  Client_NomineeDetails.cn_NomEmail AS NomEmail, Client_NomineeDetails.cn_NomPAN AS NomPan, Client_NomineeDetails.cn_NomAadhar AS NomAadhaar
FROM     Client_NomineeDetails INNER JOIN
                  Client_Backoffice ON Client_NomineeDetails.cn_cd = Client_Backoffice.cb_cmcd
WHERE  (Client_NomineeDetails.cn_cd = '10010139') AND (Client_NomineeDetails.cn_purposeCd IN (3, 6, 7, 8, 9, 10))
ORDER BY Client_NomineeDetails.cn_purposeCd</CommandText>
      </Query>
      <Fields>
        <Field Name="NomSeq">
          <DataField>NomSeq</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomName">
          <DataField>NomName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomType">
          <DataField>NomType</DataField>
