        </Field>
        <Field Name="NomAdd4">
          <DataField>NomAdd4</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomPinCode">
          <DataField>NomPinCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomMobile">
          <DataField>NomMobile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomEmail">
          <DataField>NomEmail</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NomPan">
          <DataField>NomPan</DataField>
