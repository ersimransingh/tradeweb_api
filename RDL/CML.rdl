    <DataSet Name="ClientData">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT '' AS DPID, '' AS ClientID, 'Y' AS StandInstr, 'CHINTAN' AS ShortName, 'Beneficiary' AS AcCategory, 'Resident' AS ClientType, '23/01/2007' AS AcActDate, 'Active' AS AcStatus, '' AS StatusChangeReason, 'Main Branch' AS Branch, 
                  'Ordinary' AS SubType, '' AS AcClosureDate, '' AS FHolderName, '' AS RecEStatement, '' AS FHolderFName, '' AS Occupation, '' AS CorrAdd1, '' AS CorrAdd2, '' AS CorrAdd3, '' AS CorrAdd4, '' AS CorrPincode, '' AS CorrCountry, 
                  '' AS CorrState, '' AS PerAdd1, '' AS PerAdd2, '' AS PerAdd3, '' AS PerAdd4, '' AS PerPincode, '' AS PerCountry, '' AS PerState, '' AS MobileNo, '' AS FaxNo, '' AS MobileNo2, '' AS FaxNo2, '' AS EDISFlag, '' AS IDTFlag, '' AS BankAccNo, 
                  '' AS BankAcType, '' AS BankIFSC, '' AS BankMICR, '' AS LEINo, '' AS UPIID, '' AS BankName, '' AS POADDPI, '' AS TaxStatus, '' AS BankAdd1, '' AS BankAdd2, '' AS BankAdd3, '' AS BankPinCode, '' AS GrossAnnIncome, '' AS NetWorth, 
                  '' AS NetWorthAsOnDate, '' AS FHolderPan, '' AS FHolderMobile, '' AS FHolderEmail, '' AS FHolderFamilyFlagMobile, '' AS FHolderFamilyFlagEmail, '' AS SMSFacility, '' AS PanFlag, '' AS ATHFlag, '' AS ReceiveReports, '' AS FHolderDOB, 
                  '' AS FHolderReasonAadhaar, '' AS NomName, '' AS NomPan, '' AS NomAdd1, '' AS NomAdd2, '' AS NomAdd3, '' AS NomAdd4, '' AS NomPinCode, '' AS NomAadhaar, '' AS NomEmailID, '' AS NomMobileNo, 
                  'https://localhost:44386/logo' AS LogoPath</CommandText>
      </Query>
